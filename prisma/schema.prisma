generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PICKER
}

enum DeliveryStatus {
  ACTIVE
  COMPLETED
  LEGACY
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  name         String
  passwordHash String
  role         UserRole @default(PICKER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  packlistEntries PacklistEntry[] @relation("LegacyPacklistPicker")

  createdPacklists PacklistEntry[] @relation("PacklistCreator")

  packlistAssignments PacklistPicker[]

  auditLogs AuditLog[]

  rstEntries RstEntry[]

  attendance Attendance[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PacklistEntry {
  id              String  @id @default(uuid())
  packlistNumber  String  @unique
  invoiceQuantity Int
  grossWeight     Decimal @db.Decimal(12, 2)
  pickerId        String

  createdById String?

  // Delivery life cycle methods
  status      DeliveryStatus @default(LEGACY)
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  picker User @relation("LegacyPacklistPicker", fields: [pickerId], references: [id])

  createdBy User? @relation("PacklistCreator", fields: [createdById], references: [id])

  pickers PacklistPicker[]

  @@index([pickerId])
  @@index([createdAt])
  @@index([createdById])
  @@index([status])
}

model PacklistPicker {
  id         String   @id @default(uuid())
  packlistId String
  pickerId   String
  assignedAt DateTime @default(now())

  packlist PacklistEntry @relation(fields: [packlistId], references: [id], onDelete: Cascade)

  picker User @relation(fields: [pickerId], references: [id])

  @@unique([packlistId, pickerId])
  @@index([pickerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model RstEntry {
  id          String   @id @default(uuid())
  skuCode     String
  quantity    Int
  enteredById String
  enteredAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  enteredBy User @relation(fields: [enteredById], references: [id])

  @@index([enteredAt])
  @@index([skuCode])
  @@index([enteredById])
}

model Attendance {
  id             String    @id @default(uuid())
  userId         String
  attendanceDate DateTime
  punchedInAt    DateTime
  punchedOutAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attendanceDate])
  @@index([userId])
  @@index([attendanceDate])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  PICKER
}

enum DeliveryStatus {
  ACTIVE
  COMPLETED
  LEGACY
}

enum DeliveryType {
  INWARD
  OUTWARD
  MATERIAL_RETURN
  OTHER
}

enum VerificationStatus {
  ACTIVE
  COMPLETED
}

enum VerificationResult {
  MATCHED
  DISCREPANCY
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  packlistEntries      PacklistEntry[]
  rstEntries           RstEntry[]
  invoiceVerifications InvoiceVerification[]

  @@index([isActive])
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  name         String
  passwordHash String
  role         UserRole @default(PICKER)
  isActive     Boolean  @default(true)

  /**
   * Temporarily optional because existing users
   * need to be assigned to companies.
   * ADMIN      -> companyId can be null
   * SUPERVISOR -> companyId required
   * PICKER     -> companyId required
   */
  companyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  sessions             Session[]
  packlistEntries      PacklistEntry[]       @relation("LegacyPacklistPicker")
  createdPacklists     PacklistEntry[]       @relation("PacklistCreator")
  packlistAssignments  PacklistPicker[]
  auditLogs            AuditLog[]
  rstEntries           RstEntry[]
  attendance           Attendance[]
  invoiceVerifications InvoiceVerification[]

  @@index([companyId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PacklistEntry {
  id String @id @default(uuid())

  /**
   * LEGACY FIELD
   * Existing records may contain a packlist number.
   * New records should use referenceNumber instead.
   * This field is intentionally no longer unique.
   */
  packlistNumber String?

  /**
   * Generic reference for the warehouse movement.
   * Can contain:
   * - Packlist number
   * - Invoice number
   * - Inbound number
   * - LR number
   * - Any other reference
   */
  referenceNumber String

  invoiceQuantity Int
  grossWeight     Decimal @db.Decimal(12, 2)

  /**
   * Legacy primary picker reference.
   * Keep this for backward compatibility.
   * The PacklistPicker relation remains the source
   * for multiple-picker assignments.
   */
  pickerId String

  /**
   * Company owning this warehouse movement.
   * Temporarily nullable while existing records
   * are assigned to companies.
   */
  companyId String

  createdById String?

  /**
   * Delivery lifecycle
   */
  status       DeliveryStatus @default(LEGACY)
  deliveryType DeliveryType

  startedAt   DateTime?
  completedAt DateTime?

  /**
   * Inward calculation
   * Current rule:
   * grossWeight / numberOfPickers / 2
   * The calculated result is stored so historical
   * records remain unchanged if the rule changes.
   */
  perPersonWeight    Decimal? @db.Decimal(12, 2)
  calculationVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  picker User @relation("LegacyPacklistPicker", fields: [pickerId], references: [id])

  company Company? @relation(fields: [companyId], references: [id])

  createdBy User? @relation("PacklistCreator", fields: [createdById], references: [id])

  pickers PacklistPicker[]

  @@index([pickerId])
  @@index([createdAt])
  @@index([createdById])
  @@index([status])
  @@index([companyId])
  @@index([companyId, status])
  @@index([referenceNumber])
  @@index([companyId, referenceNumber])
  @@index([packlistNumber])
}

model PacklistPicker {
  id         String   @id @default(uuid())
  packlistId String
  pickerId   String
  assignedAt DateTime @default(now())

  packlist PacklistEntry @relation(fields: [packlistId], references: [id], onDelete: Cascade)

  picker User @relation(fields: [pickerId], references: [id])

  @@unique([packlistId, pickerId])
  @@index([pickerId])
  @@index([pickerId, packlistId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model RstEntry {
  id          String @id @default(uuid())
  skuCode     String
  quantity    Int
  enteredById String
  companyId   String

  enteredAt DateTime @default(now())
  createdAt DateTime @default(now())

  enteredBy User @relation(fields: [enteredById], references: [id])

  company Company? @relation(fields: [companyId], references: [id])

  @@index([enteredAt])
  @@index([skuCode])
  @@index([enteredById])
  @@index([companyId])
}

model Attendance {
  id             String    @id @default(uuid())
  userId         String
  attendanceDate DateTime
  punchedInAt    DateTime
  punchedOutAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attendanceDate])
  @@index([userId])
  @@index([attendanceDate])
}

model InvoiceVerification {
  id String @id @default(uuid())

  invoiceNumber String

  invoicedQuantity   Int
  dispatchedQuantity Int?

  invoicedWeight   Decimal  @db.Decimal(12, 2)
  dispatchedWeight Decimal? @db.Decimal(12, 2)

  remarks String?

  result VerificationResult?

  status VerificationStatus @default(ACTIVE)

  startedAt   DateTime
  completedAt DateTime?

  supervisorId String
  companyId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supervisor User @relation(fields: [supervisorId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, invoiceNumber])
  @@index([supervisorId])
  @@index([companyId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([result])
  @@index([startedAt])
  @@index([completedAt])
  @@index([companyId, status])
  @@index([companyId, invoiceNumber])
}
